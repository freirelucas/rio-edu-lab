# MkDocs build output
site/

# Chat audit trail saídas (v0.16 — 61_session_to_issue.py). Local-only por
# default; commit explícito se quiser publicar uma sessão como issue manual.
audit/

# Claude Code settings real (não exemplo). settings.example.json fica commitado
# como template; settings.json real fica fora porque pode ter env vars locais.
.claude/settings.json
.claude/settings.local.json

# Raw downloaded binaries (reproducible via analysis/03_download_excels.py / 07_download_pdfs.py)
data/raw/excel/*.xlsx
data/raw/excel/*.xls
data/raw/pdf/*.pdf
data/raw/pdf/_first_pages/
# Keep _index.json / _provenance.json (download manifests, lightweight, useful for reproducibility)
# Geometria oficial do IPP fica versionada (foundational, ~4 MiB, não muda).
!data/raw/excel/_index.json
!data/raw/pdf/_index.json
!data/raw/geo/

# IDS por setor censitário em GeoJSON é pesado (~27 MiB) e não usado pelo
# pipeline atual (VULN-EDU agrega via CSV slim). Opt-in via
# `python3 analysis/28_fetch_ids.py --with-geometry`.
data/raw/geo/ids_setores.geojson

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Editors
.vscode/
.idea/

# OS
.DS_Store

# Snowball v2 cache + run state (efêmero; reproduzível via --refresh / --reset-visited)
data/cache/
data/snowball_visited.json
data/processed/audit_*.md
data/processed/audit_*.json

